# EchoDB-Bench paths + SLURM config (an HPC cluster
# Source this before running any script:  source config/paths.env

# --- project root (blue: ~3.2 TB free; orange is full) ---
export ECHODB_ROOT="${SQB_ROOT:-.}"
export ECHODB_RESULTS="${ECHODB_ROOT}/results"
export ECHODB_MANIFESTS="${ECHODB_ROOT}/data/manifests"

# --- source corpora (verified present 2026-08-24) ---
# Full LibriSpeech test-clean: <root>/test-clean/<spk>/<chap>/<spk>-<chap>-<utt>.flac + .trans.txt
export LIBRISPEECH_ROOT="${SQB_MODELS}"
export LIBRISPEECH_SPLIT="test-clean"

# AMI: diarization lists at AMI_ANNOT; audio + manual word annotations fetched into blue.
export AMI_ANNOT="${SQB_MODELS}"   # lists/ (test,dev)
export AMI_AUDIO="${ECHODB_ROOT}/data/raw/ami/amicorpus"                            # fetch_ami_audio.sh
export AMI_WORDS="${ECHODB_ROOT}/data/raw/ami/annotations/ami_manual/words"         # NXT word XML (ref text)

# --- python env ---
# Preferred: a dedicated venv on blue (created by scripts/setup_env.sh).
export ECHODB_VENV="${ECHODB_ROOT}/.venv"
# Fallback candidates with torch/whisper already installed:
#   ${SQB_MODELS}

# --- SLURM ---
export SLURM_ACCOUNT="mygroup"
export SLURM_PARTITION="hpg-b200"

# --- pilot config ---
# ASR tiers spanning WER (faster-whisper model ids). Comma-separated, ordered small->large.
export ASR_TIERS="tiny.en,small.en,large-v3"
export ASR_COMPUTE_TYPE="float16"
